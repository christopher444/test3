PRODUCT_API_URL=http://127.0.0.1:8001
WAREHOUSE_API_URL=http://127.0.0.1:8002
PRODUCT_API_KEY=challenge-product-key
WAREHOUSE_API_KEY=challenge-warehouse-key
PAGE_SIZE=500
BATCH_SIZE=100
PIM_RATE_PER_SECOND=10
WMS_RATE_PER_SECOND=20
PIM_MAX_IN_FLIGHT=32
WMS_MAX_IN_FLIGHT=80
MAX_RETRIES=6
RETRY_WMS_5XX=false
WORKER_MAX_IDLE_SECONDS=240
RUN_LOCK_SECONDS=120
RUN_LOCK_HEARTBEAT_SECONDS=30
CONNECT_TIMEOUT_SECONDS=5
READ_TIMEOUT_SECONDS=15
+AWS_MAX_POOL_CONNECTIONS=100
AWS_CONNECT_TIMEOUT_SECONDS=5
AWS_READ_TIMEOUT_SECONDS=30
SQS_VISIBILITY_TIMEOUT_SECONDS=300
RUNTIME_DIR=./runtime

# LocalEmu-backed AWS mode. infra/local creates a least-privilege local IAM user;
# scripts/run_localemu_pipeline.sh reads its credentials from Terraform outputs.
AWS_REGION=eu-west-1
AWS_DEFAULT_REGION=eu-west-1
AWS_ENDPOINT_URL=http://127.0.0.1:4566
LOCALEMU_ENDPOINT=http://127.0.0.1:4566
STORAGE_BACKEND=s3
STATE_BACKEND=dynamodb
QUEUE_BACKEND=sqs
S3_BUCKET=catalogue-sync-local
RUNS_TABLE=catalogue-sync-runs
BATCHES_TABLE=catalogue-sync-batches
IDEMPOTENCY_TABLE=catalogue-sync-idempotency
# Fill from: terraform -chdir=infra/local output -raw queue_url
QUEUE_URL=
# Fill from: terraform -chdir=infra/local output -raw kms_key_arn
KMS_KEY_ID=
